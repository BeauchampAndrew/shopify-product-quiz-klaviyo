{%- comment -%}
  Product Finder Quiz. One portable section: markup, CSS, JS and settings in this file.
  Docs: README.md (merchants) and AGENTS.md (AI agents) in https://github.com/BeauchampAndrew/Product_Quiz_Shopify
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  case s.button_shape
    when 'pill'
      assign btn_radius = '999px'
    when 'rounded'
      assign btn_radius = '10px'
    else
      assign btn_radius = '0px'
  endcase
  assign quiz_collection = s.collection
-%}

<product-quiz
  class="pqz{% if s.uppercase_headings %} pqz--upper{% endif %}"
  data-section-id="{{ section.id }}"
  style="--pqz-bg: {{ s.color_bg }}; --pqz-ink: {{ s.color_ink }}; --pqz-accent: {{ s.color_accent }}; --pqz-btn-fg: {{ s.color_button_text }}; --pqz-btn-radius: {{ btn_radius }}; --pqz-border: {{ s.border_width }}px; --pqz-max-width: {{ s.max_width }}em; --pqz-pad-top: {{ s.padding_top }}px; --pqz-pad-bottom: {{ s.padding_bottom }}px;"
  data-money-sample="{{ 123456789 | money | strip_html | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-root-url="{{ routes.root_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-update-url="{{ routes.cart_update_url }}"
  data-picks="{{ s.picks }}"
  data-tie-tag="{{ s.tie_tag | strip | escape }}"
  data-klaviyo-key="{{ s.klaviyo_public_key | strip | escape }}"
  data-klaviyo-list="{{ s.klaviyo_list_id | strip | escape }}"
  data-klaviyo-source="{{ s.klaviyo_source | escape }}"
  data-klaviyo-event="{{ s.klaviyo_event | escape }}"
  data-discount-code="{{ s.discount_code | strip | escape }}"
  data-discount-percent="{{ s.discount_percent }}"
  data-label-intro-heading="{{ s.intro_heading | escape }}"
  data-label-intro-text="{{ s.intro_text | escape }}"
  data-label-progress="{{ s.label_progress | escape }}"
  data-label-back="{{ s.label_back | escape }}"
  data-label-continue="{{ s.label_continue | escape }}"
  data-label-email-heading="{{ s.email_heading | escape }}"
  data-label-email-text="{{ s.email_text | escape }}"
  data-label-email-placeholder="{{ s.email_placeholder | escape }}"
  data-label-email-button="{{ s.email_button | escape }}"
  data-label-email-skip="{{ s.email_skip | escape }}"
  data-label-email-invalid="{{ s.email_invalid | escape }}"
  data-label-results-heading="{{ s.results_heading | escape }}"
  data-label-results-intro="{{ s.results_intro | escape }}"
  data-label-matches="{{ s.label_matches | escape }}"
  data-label-add="{{ s.label_add | escape }}"
  data-label-adding="{{ s.label_adding | escape }}"
  data-label-added="{{ s.label_added | escape }}"
  data-label-add-all="{{ s.label_add_all | escape }}"
  data-label-total="{{ s.label_total | escape }}"
  data-label-discount="{{ s.label_discount | escape }}"
  data-label-retake="{{ s.label_retake | escape }}"
  data-label-error="{{ s.label_error | escape }}"
  data-label-empty="{{ s.label_empty | escape }}"
>
  <div class="pqz__inner">
    <div class="pqz__stage" data-pqz-stage></div>
    <noscript><p class="pqz__empty">{{ s.label_empty }}</p></noscript>
  </div>

  {%- comment -%} Anchors so the theme editor can find each question block. JS renders the screens. {%- endcomment -%}
  {%- for block in section.blocks -%}
    <div hidden {{ block.shopify_attributes }}></div>
  {%- endfor -%}

  <script type="application/json" data-pqz-config>
    {
      "questions": [
        {%- for block in section.blocks -%}
          {
            "id": {{ block.id | json }},
            "heading": {{ block.settings.heading | json }},
            "subheading": {{ block.settings.subheading | json }},
            "answers": {{ block.settings.answers | json }},
            "multi": {{ block.settings.multi | json }},
            "role": {{ block.settings.role | json }},
            "weight": {{ block.settings.weight | default: 0 | json }},
            "field": {{ block.settings.field | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "products": [
        {%- if quiz_collection != blank -%}
          {%- for product in quiz_collection.products limit: 50 -%}
            {%- assign variant = product.selected_or_first_available_variant -%}
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "url": {{ product.url | json }},
              "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | json }}{% else %}""{% endif %},
              "price": {{ variant.price | json }},
              "variantId": {{ variant.id | json }},
              "available": {{ product.available | json }},
              "tags": {{ product.tags | json }},
              "blurb": {{ product.description | strip_html | strip_newlines | truncate: 400 | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      ]
    }
  </script>
</product-quiz>

{% stylesheet %}
  /* Product quiz. Everything is scoped under .pqz; colors and shapes come from --pqz-* variables set by the section settings. */
  .pqz {
    display: block;
    background: var(--pqz-bg);
    color: var(--pqz-ink);
    padding: var(--pqz-pad-top) 16px var(--pqz-pad-bottom);
    line-height: 1.5;
  }

  /* Neutralize theme tag styles at zero specificity; component rules below win. */
  .pqz :where(button, input) {
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
    text-transform: none;
    margin: 0;
    box-shadow: none;
    min-width: 0;
  }
  .pqz :where(button) {
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  .pqz :where(h2, h3, p) {
    margin: 0;
    padding: 0;
    color: inherit;
  }
  .pqz :where(ul, li) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pqz :where(a) {
    color: inherit;
  }
  .pqz :where(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .pqz :focus-visible {
    outline: 2px solid var(--pqz-accent);
    outline-offset: 3px;
  }
  .pqz [hidden] {
    display: none !important;
  }

  .pqz__inner {
    max-width: 72em;
    margin: 0 auto;
    text-align: center;
  }
  .pqz__screen--question,
  .pqz__screen--email {
    max-width: var(--pqz-max-width);
    margin: 0 auto;
  }

  /* Intro (question 1 only) */
  .pqz__intro {
    margin-bottom: 1.75em;
  }
  .pqz__intro-heading {
    font-size: 0.8125em;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pqz__intro-text {
    margin-top: 0.25em;
    opacity: 0.8;
  }

  /* Progress */
  .pqz__progress {
    position: relative;
    height: 12px;
    border: var(--pqz-border) solid var(--pqz-ink);
    overflow: hidden;
  }
  .pqz__progress-fill {
    display: block;
    height: 100%;
    width: var(--pqz-fill, 0%);
    background: var(--pqz-accent);
    transition: width 0.35s ease;
  }
  .pqz__progress-text {
    margin-top: 0.5em;
    font-size: 0.8125em;
    font-weight: 700;
    text-align: right;
  }

  /* Headings */
  .pqz .pqz__heading {
    margin: 1.25em 0 0;
    font-size: 1.75em;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: none;
  }
  .pqz.pqz--upper .pqz__heading {
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .pqz .pqz__heading:focus {
    outline: none;
  }
  .pqz__sub {
    margin-top: 0.75em;
    font-size: 1.0625em;
    opacity: 0.85;
  }

  /* Answers */
  .pqz__answers {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 28em;
    margin: 2em auto 0;
  }
  .pqz .pqz__answer {
    display: block;
    width: 100%;
    box-sizing: border-box;
    min-height: 52px;
    padding: 0.9em 1.25em;
    border: var(--pqz-border) solid var(--pqz-ink);
    border-radius: var(--pqz-btn-radius);
    background: transparent;
    font-size: 1.0625em;
    line-height: 1.3;
    text-align: center;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .pqz .pqz__answer:hover {
    background: color-mix(in srgb, var(--pqz-ink) 7%, transparent);
  }
  .pqz .pqz__answer[aria-pressed='true'] {
    background: var(--pqz-ink);
    color: var(--pqz-btn-fg);
  }

  /* Buttons and links */
  .pqz .pqz__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    box-sizing: border-box;
    min-height: 48px;
    padding: 0.9em 2em;
    border: var(--pqz-border) solid var(--pqz-ink);
    border-radius: var(--pqz-btn-radius);
    background: var(--pqz-ink);
    color: var(--pqz-btn-fg);
    font-size: 0.875em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: opacity 0.15s ease;
  }
  .pqz .pqz__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .pqz .pqz__btn.is-loading {
    opacity: 0.7;
    cursor: progress;
  }
  .pqz .pqz__btn--outline {
    background: transparent;
    color: var(--pqz-ink);
  }
  .pqz__continue {
    margin-top: 2.5em;
  }
  .pqz__nav {
    margin-top: 1.75em;
  }
  .pqz .pqz__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1em;
    font-size: 0.8125em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .pqz .pqz__back::before {
    content: '\2190\00a0';
  }

  /* Results */
  .pqz__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px 24px;
    margin-top: 2.5em;
  }
  .pqz__card {
    display: flex;
    flex: 1 1 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
    max-width: 24em;
    text-align: center;
  }
  .pqz__card-media {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 0.5em;
    background: color-mix(in srgb, var(--pqz-ink) 5%, transparent);
  }
  .pqz .pqz__card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .pqz .pqz__card-title {
    font-size: 1.125em;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }
  .pqz__card-title a {
    text-decoration: none;
  }
  .pqz__card-price {
    font-weight: 600;
  }
  .pqz__card-matches {
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pqz__card-blurb {
    font-size: 0.9375em;
    line-height: 1.45;
    opacity: 0.85;
  }
  .pqz .pqz__card .pqz__btn {
    width: 100%;
    margin-top: auto;
  }
  .pqz__card-cta {
    width: 100%;
    margin-top: auto;
    padding-top: 0.75em;
  }
  .pqz__summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75em;
    margin-top: 3em;
  }
  .pqz__total {
    font-size: 1.125em;
  }
  .pqz__total-label {
    margin-right: 0.4em;
  }
  .pqz__was {
    margin-right: 0.4em;
    opacity: 0.6;
  }
  .pqz__discount {
    font-size: 0.9375em;
    font-weight: 600;
  }
  .pqz__error {
    color: #b42318;
    font-size: 0.9375em;
  }
  .pqz__empty {
    margin-top: 1.5em;
  }

  @media screen and (min-width: 750px) {
    .pqz .pqz__heading {
      font-size: 2.5em;
    }
    .pqz__card {
      flex: 0 1 calc((100% - 48px) / 3);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (customElements.get('product-quiz')) return;

    // pqz:logic:start
    // Pure functions: no DOM, no network. tests/quiz-logic.test.mjs runs them directly from this file.

    // One answer per line: "Label | tag-one, tag-two". Tags are optional.
    function parseAnswers(text) {
      return String(text || '')
        .split(/\r?\n/)
        .map((line) => line.trim())
        .filter(Boolean)
        .map((line) => {
          const bar = line.indexOf('|');
          const label = (bar === -1 ? line : line.slice(0, bar)).trim();
          const tags = bar === -1 ? [] : line.slice(bar + 1).split(',').map((t) => t.trim().toLowerCase()).filter(Boolean);
          return { label, tags };
        })
        .filter((a) => a.label);
    }

    function normalizeQuestions(raw) {
      return (raw || []).map((r, i) => {
        const role = ['rank', 'extra', 'profile'].includes(r.role) ? r.role : 'rank';
        const weight = role === 'rank' ? (r.weight == null || r.weight === '' ? 5 : Number(r.weight) || 0) : 0;
        return {
          id: String(r.id),
          heading: r.heading || '',
          subheading: r.subheading || '',
          multi: Boolean(r.multi),
          role,
          weight,
          field: String(r.field || '').trim() || `quiz_q${i + 1}`,
          answers: parseAnswers(r.answers),
        };
      });
    }

    function normalizeProducts(raw) {
      return (raw || []).map((r) => ({
        id: Number(r.id),
        title: r.title || '',
        url: r.url || '',
        image: r.image || '',
        price: Number(r.price) || 0,
        variantId: Number(r.variantId),
        available: Boolean(r.available),
        tags: (r.tags || []).map((t) => String(t).trim().toLowerCase()).filter(Boolean),
        blurb: firstSentence(r.blurb),
      }));
    }

    function firstSentence(text) {
      const s = String(text || '').trim();
      const m = s.match(/^.*?[.!?](?=\s|$)/);
      return m ? m[0] : s;
    }

    // sample = Liquid's `123456789 | money`, so symbol, separators and decimals follow the shop's currency.
    function formatMoney(cents, sample) {
      const s = sample || '$1,234,567.89';
      const m = s.match(/1(\D?)234\D?56[78](?:(\D)89)?/);
      const f = m
        ? { prefix: s.slice(0, m.index), suffix: s.slice(m.index + m[0].length), thousands: m[1], point: m[2] || '', decimals: m[2] ? 2 : 0 }
        : { prefix: '$', suffix: '', thousands: ',', point: '.', decimals: 2 };
      const [whole, frac] = (cents / 100).toFixed(f.decimals).split('.');
      return f.prefix + whole.replace(/\B(?=(\d{3})+(?!\d))/g, f.thousands) + (frac ? f.point + frac : '') + f.suffix;
    }

    const tagKey = (tags) => [...tags].sort().join(',');
    const shares = (a, b) => a.some((t) => b.includes(t));

    // In an "extra" question, hide answers the shopper already chose in an earlier question (same tags).
    function hiddenAnswers(questions, picks, qIndex) {
      const hidden = new Set();
      const question = questions[qIndex];
      if (!question || question.role !== 'extra') return hidden;
      const chosen = new Set();
      questions.slice(0, qIndex).forEach((q) => {
        (picks[q.id] || []).forEach((i) => {
          const a = q.answers[i];
          if (a && a.tags.length) chosen.add(tagKey(a.tags));
        });
      });
      question.answers.forEach((a, i) => {
        if (a.tags.length && chosen.has(tagKey(a.tags))) hidden.add(i);
      });
      return hidden;
    }

    function prunePicks(questions, picks) {
      const out = {};
      questions.forEach((q, qi) => {
        if (!picks[q.id]) return;
        const hidden = hiddenAnswers(questions, picks, qi);
        out[q.id] = picks[q.id].filter((i) => !hidden.has(i));
      });
      return out;
    }

    // Multi-select toggle. A tagless answer means "none of these": it clears the others and vice versa.
    function toggleMulti(answers, selected, index) {
      if (selected.includes(index)) return selected.filter((i) => i !== index);
      const answer = answers[index];
      if (answer && !answer.tags.length) return [index];
      return [...selected.filter((i) => answers[i] && answers[i].tags.length), index];
    }

    function pickStack(products, questions, picks, opts) {
      const count = Math.max(1, Number(opts.count) || 1);
      const tieTag = String(opts.tieTag || '').trim().toLowerCase();
      const chosen = (role) =>
        questions
          .filter((q) => q.role === role)
          .flatMap((q) => (picks[q.id] || []).map((i) => ({ q, a: q.answers[i] })))
          .filter((c) => c.a);
      const rankPicks = chosen('rank');
      const score = (p) => rankPicks.reduce((sum, c) => sum + (shares(c.a.tags, p.tags) ? c.q.weight : 0), 0);
      const ranked = products
        .map((p, index) => ({ p, index, score: score(p), tie: tieTag && p.tags.includes(tieTag) ? 1 : 0 }))
        .filter((r) => r.p.available)
        .sort((a, b) => b.score - a.score || b.tie - a.tie || a.index - b.index)
        .map((r) => r.p);
      if (!ranked.length) return [];

      const used = new Set([ranked[0]]);
      const extraAnswers = chosen('extra')
        .map((c) => c.a)
        .filter((a) => a.tags.length)
        .slice(0, count - 1);
      const extras = [];
      extraAnswers.forEach((a) => {
        const hit = ranked.find((p) => !used.has(p) && shares(p.tags, a.tags));
        if (hit) {
          extras.push(hit);
          used.add(hit);
        }
      });
      const rest = ranked.filter((p) => !used.has(p)).slice(0, Math.max(0, count - 1 - extras.length));

      const matchable = [...rankPicks, ...chosen('extra')];
      return [ranked[0], ...extras, ...rest].slice(0, count).map((product) => ({
        product,
        matches: [...new Set(matchable.filter((c) => shares(c.a.tags, product.tags)).map((c) => c.a.label))],
      }));
    }

    function profileProperties(questions, picks) {
      const out = {};
      questions.forEach((q) => {
        const labels = (picks[q.id] || []).map((i) => q.answers[i] && q.answers[i].label).filter(Boolean);
        if (!labels.length) return;
        out[q.field] = q.multi ? labels : labels[0];
      });
      return out;
    }

    function discountedTotal(cents, percent) {
      return cents - Math.round((cents * (Number(percent) || 0)) / 100);
    }

    // Saved progress may come from an older version of the quiz (questions edited in the theme editor).
    function sanitizeState(questions, state) {
      if (!state || typeof state !== 'object') return null;
      const n = questions.length;
      const step = state.step;
      if (!Number.isInteger(step) || step < 0 || step > n + 1) return null;
      const picks = {};
      const raw = state.picks && typeof state.picks === 'object' ? state.picks : {};
      questions.forEach((q) => {
        if (!Array.isArray(raw[q.id])) return;
        const valid = raw[q.id].filter((i) => Number.isInteger(i) && i >= 0 && i < q.answers.length);
        if (valid.length) picks[q.id] = valid;
      });
      const firstOpen = questions.findIndex((q) => !picks[q.id]);
      return { step: firstOpen === -1 ? step : Math.min(step, firstOpen), picks, claimed: Boolean(state.claimed) };
    }

    function subscriptionBody({ email, listId, source, properties }) {
      return {
        data: {
          type: 'subscription',
          attributes: {
            custom_source: source,
            profile: {
              data: {
                type: 'profile',
                attributes: { email, properties, subscriptions: { email: { marketing: { consent: 'SUBSCRIBED' } } } },
              },
            },
          },
          relationships: { list: { data: { type: 'list', id: listId } } },
        },
      };
    }

    function eventBody({ email, eventName, properties, profileProperties, value, currency }) {
      return {
        data: {
          type: 'event',
          attributes: {
            properties,
            metric: { data: { type: 'metric', attributes: { name: eventName } } },
            profile: { data: { type: 'profile', attributes: { email, properties: profileProperties } } },
            value,
            value_currency: currency,
          },
        },
      };
    }

    function eventProperties({ questions, picks, stack, code, origin }) {
      const absolute = (url) => (url.startsWith('//') ? `https:${url}` : url.startsWith('/') ? origin + url : url);
      return {
        answers: profileProperties(questions, picks),
        products: stack.map(({ product }) => ({
          title: product.title,
          url: absolute(product.url),
          image: product.image ? absolute(product.image) : '',
          price: product.price / 100,
        })),
        product_titles: stack.map(({ product }) => product.title),
        discount_code: code || null,
      };
    }
    // pqz:logic:end

    const el = (tag, className, text) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text != null) node.textContent = text;
      return node;
    };

    class ProductQuiz extends HTMLElement {
      connectedCallback() {
        let config = {};
        try {
          config = JSON.parse(this.querySelector('[data-pqz-config]').textContent);
        } catch (e) {
          console.warn('[product-quiz] could not read the quiz config', e);
        }
        this.questions = normalizeQuestions(config.questions);
        this.products = normalizeProducts(config.products);
        this.stage = this.querySelector('[data-pqz-stage]');
        this.storageKey = `pqz:${this.dataset.sectionId}:${window.location.pathname}`;
        this.state = this.restore();

        this.onClick = this.onClick.bind(this);
        this.onBlockSelect = this.onBlockSelect.bind(this);
        this.addEventListener('click', this.onClick);
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        this.render();
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
        clearTimeout(this.advanceTimer);
      }

      // ---- labels ----
      // t('emailHeading', { percent: 15 }) reads data-label-email-heading and fills [percent].
      t(key, vars = {}) {
        const raw = this.dataset[`label${key[0].toUpperCase()}${key.slice(1)}`] || '';
        return raw.replace(/\[(\w+)\]/g, (m, name) => (name in vars ? String(vars[name]) : m));
      }

      money(cents) {
        return formatMoney(cents, this.dataset.moneySample);
      }

      // ---- state ----
      freshState() {
        return { step: 0, picks: {}, claimed: false };
      }

      save() {
        try {
          sessionStorage.setItem(this.storageKey, JSON.stringify(this.state));
        } catch (e) {}
      }

      restore() {
        try {
          const saved = sanitizeState(this.questions, JSON.parse(sessionStorage.getItem(this.storageKey)));
          if (saved) return saved;
        } catch (e) {}
        return this.freshState();
      }

      get count() {
        return this.questions.length;
      }

      get discountActive() {
        return Boolean(this.state.claimed && this.dataset.discountCode);
      }

      stack() {
        return pickStack(this.products, this.questions, prunePicks(this.questions, this.state.picks), {
          count: Number(this.dataset.picks) || 3,
          tieTag: this.dataset.tieTag,
        });
      }

      // ---- navigation ----
      go(step) {
        this.state.step = step;
        this.save();
        this.render();
        const focusTarget = this.stage.querySelector('[data-pqz-focus]');
        if (focusTarget) focusTarget.focus({ preventScroll: true });
        if (this.getBoundingClientRect().top < 0) this.scrollIntoView({ block: 'start' });
      }

      next() {
        const step = this.state.step;
        this.go(step < this.count - 1 ? step + 1 : this.count + 1);
      }

      back() {
        if (this.state.step > 0) this.go(Math.min(this.state.step, this.count) - 1);
      }

      retake() {
        try {
          sessionStorage.removeItem(this.storageKey);
        } catch (e) {}
        this.state = this.freshState();
        this.go(0);
      }

      onBlockSelect(event) {
        const detail = event.detail || {};
        if (detail.sectionId !== this.dataset.sectionId) return;
        const index = this.questions.findIndex((q) => q.id === detail.blockId);
        if (index === -1) return;
        this.state.step = index;
        this.render();
      }

      onClick(event) {
        const target = event.target.closest('button');
        if (!target || !this.contains(target)) return;
        if (target.matches('[data-pqz-answer]')) this.answer(Number(target.dataset.pqzAnswer));
        else if (target.matches('[data-pqz-continue]')) this.next();
        else if (target.matches('[data-pqz-back]')) this.back();
        else if (target.matches('[data-pqz-retake]')) this.retake();
      }

      visiblePicks(index) {
        const q = this.questions[index];
        const hidden = hiddenAnswers(this.questions, this.state.picks, index);
        return (this.state.picks[q.id] || []).filter((i) => !hidden.has(i));
      }

      answer(index) {
        if (this.advancing) return;
        const step = this.state.step;
        const q = this.questions[step];
        if (!q) return;
        if (q.multi) {
          const picked = toggleMulti(q.answers, this.visiblePicks(step), index);
          if (picked.length) this.state.picks[q.id] = picked;
          else delete this.state.picks[q.id];
          this.save();
          this.render();
          const again = this.stage.querySelector(`[data-pqz-answer="${index}"]`);
          if (again) again.focus();
          return;
        }
        this.state.picks[q.id] = [index];
        this.save();
        this.stage.querySelectorAll('[data-pqz-answer]').forEach((b) => {
          b.setAttribute('aria-pressed', String(Number(b.dataset.pqzAnswer) === index));
        });
        // Brief pause so the shopper sees their pick; ignore further taps so a double tap can't skip a question.
        this.advancing = true;
        this.advanceTimer = setTimeout(() => {
          this.advancing = false;
          this.next();
        }, 200);
      }

      // ---- rendering ----
      render() {
        this.stage.replaceChildren();
        if (!this.count) {
          this.stage.append(el('p', 'pqz__empty', this.t('empty')));
          return;
        }
        const step = this.state.step;
        if (step < this.count) this.renderQuestion(step);
        else this.renderResults();
      }

      heading(text) {
        const h = el('h2', 'pqz__heading', text);
        h.tabIndex = -1;
        h.dataset.pqzFocus = '';
        h.id = `pqz-${this.dataset.sectionId}-heading`;
        return h;
      }

      renderQuestion(index) {
        const q = this.questions[index];
        const screen = el('div', 'pqz__screen pqz__screen--question');

        const introHeading = this.t('introHeading');
        const introText = this.t('introText');
        if (index === 0 && (introHeading || introText)) {
          const intro = el('div', 'pqz__intro');
          if (introHeading) intro.append(el('p', 'pqz__intro-heading', introHeading));
          if (introText) intro.append(el('p', 'pqz__intro-text', introText));
          screen.append(intro);
        }

        const progressText = this.t('progress', { current: index + 1, total: this.count });
        const bar = el('div', 'pqz__progress');
        bar.setAttribute('role', 'progressbar');
        bar.setAttribute('aria-valuemin', '1');
        bar.setAttribute('aria-valuemax', String(this.count));
        bar.setAttribute('aria-valuenow', String(index + 1));
        bar.setAttribute('aria-valuetext', progressText);
        bar.style.setProperty('--pqz-fill', `${((index + 1) / this.count) * 100}%`);
        bar.append(el('span', 'pqz__progress-fill'));
        screen.append(bar, el('p', 'pqz__progress-text', progressText));

        const h = this.heading(q.heading);
        screen.append(h);
        if (q.subheading) screen.append(el('p', 'pqz__sub', q.subheading));

        const hidden = hiddenAnswers(this.questions, this.state.picks, index);
        const picked = this.visiblePicks(index);
        const list = el('div', 'pqz__answers');
        list.setAttribute('role', 'group');
        list.setAttribute('aria-labelledby', h.id);
        q.answers.forEach((a, i) => {
          if (hidden.has(i)) return;
          const b = el('button', 'pqz__answer', a.label);
          b.type = 'button';
          b.dataset.pqzAnswer = String(i);
          b.setAttribute('aria-pressed', String(picked.includes(i)));
          list.append(b);
        });
        screen.append(list);

        if (q.multi) {
          const go = el('button', 'pqz__btn pqz__continue', this.t('continue'));
          go.type = 'button';
          go.dataset.pqzContinue = '';
          go.disabled = !picked.length;
          screen.append(go);
        }

        if (index > 0) {
          const nav = el('div', 'pqz__nav');
          const back = el('button', 'pqz__link pqz__back', this.t('back'));
          back.type = 'button';
          back.dataset.pqzBack = '';
          nav.append(back);
          screen.append(nav);
        }

        this.stage.append(screen);
      }

      renderResults() {
        const items = this.stack();
        const screen = el('div', 'pqz__screen pqz__screen--results');
        screen.append(this.heading(this.t('resultsHeading')));
        const intro = this.t('resultsIntro');
        if (intro) screen.append(el('p', 'pqz__sub', intro));

        if (!items.length) {
          screen.append(el('p', 'pqz__empty', this.t('empty')), this.retakeButton());
          this.stage.append(screen);
          return;
        }

        const grid = el('ul', 'pqz__grid');
        items.forEach(({ product, matches }) => {
          const card = el('li', 'pqz__card');
          card.dataset.pqzCard = '';
          const media = el('a', 'pqz__card-media');
          media.href = product.url;
          media.tabIndex = -1;
          media.setAttribute('aria-hidden', 'true');
          if (product.image) {
            const img = el('img');
            img.src = product.image;
            img.alt = '';
            img.loading = 'lazy';
            img.width = 600;
            img.height = 600;
            media.append(img);
          }
          const title = el('h3', 'pqz__card-title');
          const link = el('a', '', product.title);
          link.href = product.url;
          title.append(link);
          card.append(media, title, el('p', 'pqz__card-price', this.money(product.price)));
          if (matches.length) card.append(el('p', 'pqz__card-matches', this.t('matches', { answers: matches.join(' · ') })));
          if (product.blurb) card.append(el('p', 'pqz__card-blurb', product.blurb));
          const cta = el('div', 'pqz__card-cta');
          const add = el('button', 'pqz__btn', this.t('add'));
          add.type = 'button';
          add.dataset.pqzAdd = '';
          add.dataset.variantId = String(product.variantId);
          add.dataset.label = this.t('add');
          cta.append(add);
          card.append(cta);
          grid.append(card);
        });
        screen.append(grid);

        const total = items.reduce((sum, { product }) => sum + product.price, 0);
        const summary = el('div', 'pqz__summary');
        const totalLine = el('p', 'pqz__total');
        totalLine.dataset.pqzTotal = '';
        totalLine.append(el('span', 'pqz__total-label', this.t('total')));
        if (this.discountActive) {
          totalLine.append(el('s', 'pqz__was', this.money(total)));
          totalLine.append(el('strong', '', this.money(discountedTotal(total, this.dataset.discountPercent))));
        } else {
          totalLine.append(el('strong', '', this.money(total)));
        }
        const addAll = el('button', 'pqz__btn', this.t('addAll'));
        addAll.type = 'button';
        addAll.dataset.pqzAddAll = '';
        addAll.dataset.label = this.t('addAll');
        const discount = el(
          'p',
          'pqz__discount',
          this.t('discount', { percent: this.dataset.discountPercent, code: this.dataset.discountCode })
        );
        discount.dataset.pqzDiscount = '';
        discount.hidden = !this.discountActive;
        const error = el('p', 'pqz__error');
        error.dataset.pqzError = '';
        error.setAttribute('role', 'alert');
        error.hidden = true;
        summary.append(totalLine, addAll, discount, error, this.retakeButton());
        screen.append(summary);
        this.stage.append(screen);
      }

      retakeButton() {
        const b = el('button', 'pqz__link', this.t('retake'));
        b.type = 'button';
        b.dataset.pqzRetake = '';
        return b;
      }
    }

    customElements.define('product-quiz', ProductQuiz);
  })();
{% endjavascript %}

